---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { checkAuth } from '@/lib/auth/middleware';
import { userHasFeature, FEATURES } from '@/lib/permissions';
import { prisma } from '@/lib/db';
import { withTenantWhere } from '@/lib/repositories/tenant-helpers';

const auth = await checkAuth(Astro);
if (!auth.authenticated || !auth.user) {
  return Astro.redirect('/login');
}

const hasAccess = await userHasFeature(auth.user.id, FEATURES.CUSTOMERS);
if (!hasAccess) {
  return Astro.redirect('/');
}

const url = new URL(Astro.request.url);
const sp = url.searchParams;
const q = (sp.get('q') || '').trim();
const sinceId = sp.get('sinceId') || undefined;
const limit = 25;

const where: any = withTenantWhere({});
if (sinceId) where.id = { gt: sinceId };
if (q) {
  where.OR = [
    { email: { contains: q, mode: 'insensitive' } },
    { firstName: { contains: q, mode: 'insensitive' } },
    { lastName: { contains: q, mode: 'insensitive' } },
  ];
}

const fetched = await prisma.customer.findMany({
  where,
  orderBy: { id: 'asc' },
  take: limit + 1,
});
const hasMore = fetched.length > limit;
const items = hasMore ? fetched.slice(0, limit) : fetched;
const lastId = items.length > 0 ? items[items.length - 1].id : null;

function nextHref(): string {
  if (!lastId) return '#';
  const params = new URLSearchParams(url.searchParams);
  params.set('sinceId', lastId);
  return `/customers?${params.toString()}`;
}
---

<AdminLayout title="Customers" activeNav="customers">
  <div class="bg-ds-card border border-ds-line rounded-[10px] shadow-[0_1px_2px_rgba(17,24,39,.04)]">
    <div class="px-6 pt-5 pb-4 flex items-start justify-between gap-4 flex-wrap">
      <div class="min-w-0">
        <div class="text-[14px] font-semibold text-ds-ink">All customers</div>
        <div class="text-[12.5px] text-ds-muted mt-0.5">
          Showing <span class="font-ds-mono tabular">{items.length}</span> customers
        </div>
      </div>
      <form method="get" action="/customers" class="flex items-center gap-2 shrink-0 flex-wrap">
        <input
          type="search"
          name="q"
          value={q}
          placeholder="Search email or name..."
          class="h-8 px-3 text-[13px] rounded-[7px] border border-ds-line bg-ds-card text-ds-ink placeholder:text-ds-muted focus:outline-none focus:ring-2 focus:ring-ds-accent w-[240px]"
        />
        <button
          type="submit"
          class="h-8 px-3 text-[13px] rounded-[7px] border border-ds-line bg-ds-card text-ds-ink hover:bg-[#F9FAFB]"
        >
          Search
        </button>
      </form>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full border-collapse">
        <thead class="bg-ds-surface2 border-b border-ds-line">
          <tr>
            <th class="px-4 py-2.5 text-[11.5px] uppercase tracking-[0.02em] font-medium text-ds-muted text-left">Email</th>
            <th class="px-4 py-2.5 text-[11.5px] uppercase tracking-[0.02em] font-medium text-ds-muted text-left">Name</th>
            <th class="px-4 py-2.5 text-[11.5px] uppercase tracking-[0.02em] font-medium text-ds-muted text-left">Phone</th>
            <th class="px-4 py-2.5 text-[11.5px] uppercase tracking-[0.02em] font-medium text-ds-muted text-right">Orders</th>
            <th class="px-4 py-2.5 text-[11.5px] uppercase tracking-[0.02em] font-medium text-ds-muted text-right">Total spent</th>
          </tr>
        </thead>
        <tbody>
          {items.length === 0 ? (
            <tr>
              <td colspan="5" class="px-4 py-10 text-center text-[13px] text-ds-muted">No customers yet.</td>
            </tr>
          ) : items.map((c) => {
            const name = [c.firstName, c.lastName].filter(Boolean).join(' ').trim();
            return (
              <tr class="hover:bg-ds-surface2 transition-colors">
                <td class="px-4 py-3 text-[13.5px] border-b border-[#F3F4F6]">
                  <a href={`/customers/${c.id}`} class="text-ds-ink font-medium hover:underline no-underline">
                    {c.email}
                  </a>
                </td>
                <td class="px-4 py-3 text-[13.5px] text-ds-ink border-b border-[#F3F4F6]">{name || '—'}</td>
                <td class="px-4 py-3 text-[13.5px] text-ds-slate border-b border-[#F3F4F6]">{c.phone || '—'}</td>
                <td class="px-4 py-3 text-[13.5px] text-ds-ink font-ds-mono tabular border-b border-[#F3F4F6] text-right">{c.ordersCount}</td>
                <td class="px-4 py-3 text-[13.5px] text-ds-ink font-ds-mono tabular border-b border-[#F3F4F6] text-right">{Number(c.totalSpent).toFixed(2)}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <div class="px-6 py-3 flex items-center justify-end gap-2 border-t border-ds-line">
      <button disabled class="h-8 px-3 text-[13px] rounded-[7px] border border-ds-line bg-ds-card text-ds-muted opacity-50">Previous</button>
      {hasMore ? (
        <a href={nextHref()} class="inline-flex items-center justify-center h-8 px-3 text-[13px] rounded-[7px] border border-ds-line bg-ds-card text-ds-ink hover:bg-[#F9FAFB] no-underline">Next</a>
      ) : (
        <button disabled class="h-8 px-3 text-[13px] rounded-[7px] border border-ds-line bg-ds-card text-ds-muted opacity-50">Next</button>
      )}
    </div>
  </div>
</AdminLayout>
