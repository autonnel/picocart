---
import { checkAuth } from '@/lib/auth/middleware';
import { userHasFeature, FEATURES, canAccessPermissionsPageAsync, getPermissionAdminIds } from '@/lib/permissions';
import { WORKSPACE_NAV, SETTINGS_NAV, type NavChild, type NavGroup } from '@/lib/dashboard/nav';

interface Props {
  activeNav?: string;
}

const { activeNav } = Astro.props;

const auth = await checkAuth(Astro);
const userId = auth.user?.id ?? '';
const userProviderId = auth.user?.providerId ?? '';

const adminIds = getPermissionAdminIds();
const isPermissionsAdmin =
  adminIds.length === 0 ||
  (userId && adminIds.includes(userId)) ||
  (userProviderId && adminIds.includes(userProviderId));

const featureChecks = userId
  ? await Promise.all([
      userHasFeature(userId, FEATURES.OVERVIEW),
      userHasFeature(userId, FEATURES.PRODUCTS),
      userHasFeature(userId, FEATURES.ORDERS),
      userHasFeature(userId, FEATURES.CUSTOMERS),
      userHasFeature(userId, FEATURES.SETTINGS),
      userHasFeature(userId, FEATURES.SETTINGS_CURRENCIES),
      userHasFeature(userId, FEATURES.SETTINGS_STORAGE),
      userHasFeature(userId, FEATURES.SETTINGS_API_KEYS),
      userHasFeature(userId, FEATURES.SETTINGS_USERS),
      canAccessPermissionsPageAsync(userId, userProviderId),
    ])
  : Array<boolean>(10).fill(true);

const [
  canOverview,
  canProducts,
  canOrders,
  canCustomers,
  canSettings,
  canCurrencies,
  canStorage,
  canApiKeys,
  canUsers,
  canPermissions,
] = featureChecks;

interface VisibleChild extends NavChild {
  visible: boolean;
}

interface VisibleItem {
  id: string;
  label: string;
  href?: string;
  visible: boolean;
  children?: VisibleChild[];
}

const VISIBILITY: Record<string, boolean> = {
  overview: canOverview,
  products: canProducts,
  orders: canOrders,
  customers: canCustomers,
  'settings.currencies': canSettings || canCurrencies,
  'settings.storage': canSettings || canStorage,
  'settings.api-keys': canSettings || canApiKeys,
  'settings.users': canSettings || canUsers,
  'settings.permissions': canPermissions || !!isPermissionsAdmin,
};

function decorateGroup(group: NavGroup): VisibleItem {
  if (group.children && group.children.length > 0) {
    const decorated = group.children.map((c) => ({ ...c, visible: VISIBILITY[c.id] ?? false }));
    return {
      id: group.id,
      label: group.label,
      href: group.href,
      visible: decorated.some((c) => c.visible),
      children: decorated,
    };
  }
  return {
    id: group.id,
    label: group.label,
    href: group.href,
    visible: VISIBILITY[group.id] ?? false,
  };
}

const workspaceItems: VisibleItem[] = WORKSPACE_NAV.map(decorateGroup);
const settingsItem: VisibleItem = decorateGroup(SETTINGS_NAV);

const ICONS: Record<string, string> = {
  overview:
    '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  products:
    '<path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.3 7l8.7 5l8.7-5"/><path d="M12 22V12"/>',
  orders:
    '<path d="M5 7h14l-1.5 11a2 2 0 0 1-2 1.7H8.5a2 2 0 0 1-2-1.7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/>',
  customers:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9"/><path d="M16 3.1a4 4 0 0 1 0 7.8"/>',
  settings:
    '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3a1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5a1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8a1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1a1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3h.1a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5a1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8v.1a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
};

function svg(id: string): string {
  const inner = ICONS[id] || '';
  return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">${inner}</svg>`;
}

const activeTop = activeNav ? activeNav.split('.')[0] : '';
const expandedFromActive = activeNav && activeNav.includes('.') ? activeTop : '';
---

<aside
  class="fixed left-0 top-0 bottom-0 w-[240px] bg-ds-surface2 border-r border-ds-line flex flex-col font-ds-sans text-ds-ink z-30"
  aria-label="Primary navigation"
  data-active-nav={activeNav}
  data-active-top={activeTop}
  data-expanded-from-active={expandedFromActive}
>
  <div class="px-4 pt-4 pb-3 flex items-center gap-2.5">
    <div class="w-6 h-6 rounded-[6px] bg-ds-ink flex items-center justify-center shrink-0">
      <svg viewBox="0 0 16 16" fill="none" class="w-3 h-3" aria-hidden="true">
        <path d="M3 3h10v3H3zM3 8h10v3H3zM3 13h6v0H3z" fill="white" />
      </svg>
    </div>
    <span class="text-[14px] font-semibold tracking-tight">Picocart</span>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 pb-3 flex flex-col gap-4 min-h-0">
    <div>
      <div class="px-2 pb-1.5 text-[10.5px] uppercase tracking-[0.06em] text-ds-faint font-medium">
        Manage
      </div>
      <div class="flex flex-col gap-0.5">
        {workspaceItems.filter((i) => i.visible).map((item) => {
          const isActive = activeNav === item.id;
          const cls = isActive
            ? 'flex items-center gap-2 text-[13.5px] rounded-md px-2.5 py-[7px] bg-ds-card border border-ds-line shadow-[0_1px_2px_rgba(17,24,39,.04)] text-ds-ink no-underline'
            : 'flex items-center gap-2 text-[13.5px] rounded-md px-2.5 py-[7px] border border-transparent text-[#374151] hover:bg-[#F3F4F6] hover:text-ds-ink no-underline';
          return (
            <a href={item.href!} class={cls} aria-current={isActive ? 'page' : undefined}>
              <span class="shrink-0 text-ds-muted" set:html={svg(item.id)} aria-hidden="true"></span>
              <span class="flex-1 truncate">{item.label}</span>
            </a>
          );
        })}
        {settingsItem.visible && (() => {
          const visibleChildren = (settingsItem.children || []).filter((c) => c.visible);
          const isParentActive = activeTop === settingsItem.id;
          return (
            <div class="picocart-sidebar-group" data-group-id={settingsItem.id}>
              <button
                type="button"
                class={
                  isParentActive
                    ? 'picocart-sidebar-toggle w-full flex items-center gap-2 text-[13.5px] rounded-md px-2.5 py-[7px] bg-ds-card border border-ds-line shadow-[0_1px_2px_rgba(17,24,39,.04)] text-ds-ink'
                    : 'picocart-sidebar-toggle w-full flex items-center gap-2 text-[13.5px] rounded-md px-2.5 py-[7px] border border-transparent text-[#374151] hover:bg-[#F3F4F6] hover:text-ds-ink'
                }
                aria-expanded="false"
                aria-controls={`picocart-sidebar-children-${settingsItem.id}`}
              >
                <span class="shrink-0 text-ds-muted" set:html={svg(settingsItem.id)} aria-hidden="true"></span>
                <span class="flex-1 truncate text-left">{settingsItem.label}</span>
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  class="picocart-sidebar-caret w-3.5 h-3.5 text-ds-muted shrink-0 transition-transform"
                  aria-hidden="true"
                >
                  <path d="M4 6l4 4l4-4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <div
                id={`picocart-sidebar-children-${settingsItem.id}`}
                class="picocart-sidebar-children hidden mt-0.5 ml-3.5 pl-2.5 border-l border-ds-line flex flex-col gap-0.5"
              >
                {visibleChildren.map((c) => {
                  const childActive = activeNav === c.id;
                  const cls = childActive
                    ? 'flex items-center gap-2 text-[12.5px] rounded-md px-2.5 py-[6px] bg-ds-card border border-ds-line shadow-[0_1px_2px_rgba(17,24,39,.04)] text-ds-ink no-underline'
                    : 'flex items-center gap-2 text-[12.5px] rounded-md px-2.5 py-[6px] border border-transparent text-[#4B5563] hover:bg-[#F3F4F6] hover:text-ds-ink no-underline';
                  return (
                    <a href={c.href} class={cls} aria-current={childActive ? 'page' : undefined}>
                      <span class="flex-1 truncate">{c.label}</span>
                    </a>
                  );
                })}
              </div>
            </div>
          );
        })()}
      </div>
    </div>
  </nav>
</aside>

<script is:inline>
  (function () {
    const STORAGE_KEY = 'picocart:sidebar:expanded';
    const DEFAULT_EXPANDED = ['settings'];
    const aside = document.querySelector('aside[data-active-nav]');
    if (!aside) return;
    const expandedFromActive = aside.getAttribute('data-expanded-from-active') || '';

    let stored = null;
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) stored = parsed.filter((x) => typeof x === 'string');
      }
    } catch (e) {
      stored = null;
    }

    const expanded = new Set(stored === null ? DEFAULT_EXPANDED : stored);
    if (expandedFromActive) expanded.add(expandedFromActive);

    function persist() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(Array.from(expanded)));
      } catch (e) {
        /* ignore */
      }
    }

    const groups = aside.querySelectorAll('.picocart-sidebar-group');
    groups.forEach((group) => {
      const id = group.getAttribute('data-group-id') || '';
      const toggle = group.querySelector('.picocart-sidebar-toggle');
      const children = group.querySelector('.picocart-sidebar-children');
      const caret = group.querySelector('.picocart-sidebar-caret');
      if (!toggle || !children) return;

      function applyState() {
        const isOpen = expanded.has(id);
        if (isOpen) {
          children.classList.remove('hidden');
          if (caret) caret.style.transform = 'rotate(180deg)';
          toggle.setAttribute('aria-expanded', 'true');
        } else {
          children.classList.add('hidden');
          if (caret) caret.style.transform = '';
          toggle.setAttribute('aria-expanded', 'false');
        }
      }

      applyState();

      toggle.addEventListener('click', function () {
        if (expanded.has(id)) expanded.delete(id);
        else expanded.add(id);
        persist();
        applyState();
      });
    });

    persist();
  })();
</script>
