DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/picocart

PORT=4322

# --- Cloudflare Workers deployment only ---
# Only needed when deploying to Cloudflare Workers. Used by
# scripts/generate-wrangler.mjs to generate wrangler.toml from
# wrangler.toml.template. Skip this section for Node deployments.
#
# Alternative: run `npm run generate:wrangler` once, commit the generated
# wrangler.toml to your own repository, and let Cloudflare's Git-based CI/CD
# (Workers Builds) deploy on every push — see README "Cloudflare Workers".

# Required for Cloudflare deployment:
# CF_WORKER_NAME=picocart
# CF_KV_NAMESPACE_ID=your-kv-namespace-id
# CF_HYPERDRIVE_CONFIG_ID=your-hyperdrive-config-id

# Optional:
# CF_KV_PREVIEW_NAMESPACE_ID=your-kv-preview-namespace-id
# CF_HYPERDRIVE_LOCAL_CONNECTION_STRING=postgresql://... (defaults to DATABASE_URL)
